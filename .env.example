# =====================================================================
# BetterBankings Frontend — environment template
# Copy to `.env.local` and adjust:   cp .env.example .env.local
# =====================================================================

# Local development (backend in Docker on the same machine):
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# Production example:
# NEXT_PUBLIC_API_URL=https://api.betterbankings.com/api

# --- Optional: Cloudinary client-side uploads -----------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
